{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
                { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
                { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://ngphbcrdphluuphctvpr.supabase.co; connect-src 'self' https://ngphbcrdphluuphctvpr.supabase.co wss://ngphbcrdphluuphctvpr.supabase.co https://viacep.com.br; frame-src https://www.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" }
            ]
        }
    ],
    "redirects": [
        { "source": "/(.*)", "has": [{ "type": "host", "value": "site-graphene.vercel.app" }], "destination": "https://www.graphenemanipulacoes.com.br/$1", "permanent": false }
    ],
    "rewrites": [
        { "source": "/ativos", "destination": "/ativos.html" },
        { "source": "/laboratorio", "destination": "/laboratorio.html" },
        { "source": "/receita", "destination": "/receita.html" },
        { "source": "/prescritores", "destination": "/prescritores.html" },
        { "source": "/avaliacoes", "destination": "/avaliacoes.html" },
        { "source": "/parceiros", "destination": "/parceiros.html" },
        { "source": "/sobre", "destination": "/sobre.html" },
        { "source": "/compras", "destination": "/compras.html" },
        { "source": "/trocas", "destination": "/trocas.html" },
        { "source": "/privacidade", "destination": "/privacidade.html" },
        { "source": "/produto/:id", "destination": "/api/produto?id=:id" },
        { "source": "/cupom/:code", "destination": "/index.html" },
        { "source": "/feed.xml", "destination": "/api/feed" },
        { "source": "/sitemap-produtos.xml", "destination": "/api/sitemap-produtos" },
        { "source": "/admin", "destination": "/private.html" },
        { "source": "/balcaographene", "destination": "/private.html" },
        { "source": "/colaboradores", "destination": "/private.html" },
        { "source": "/farmaceutico", "destination": "/private.html" },
        { "source": "/login", "destination": "/private.html" },
        { "source": "/entrar", "destination": "/private.html" },
        { "source": "/minha-conta", "destination": "/private.html" },
        { "source": "/carrinho", "destination": "/private.html" },
        { "source": "/checkout", "destination": "/private.html" },
        { "source": "/pedido/retorno", "destination": "/private.html" },
        { "source": "/redefinir-senha", "destination": "/private.html" },
        { "source": "/parceiros/entrar", "destination": "/private.html" },
        { "source": "/parceiros/painel", "destination": "/private.html" },
        { "source": "/parceiros/cadastro", "destination": "/private.html" }
    ]
}
